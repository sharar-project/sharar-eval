# Options every engine baseline runs with. Sourced by run.sh and the engines' serve.sh before versions.env and the
# setting, so either may override them.

# the benchmark: a suite of sharar-eval's evals/workloads/efficiency_v1.json. cross-engine is the comparison
# (warm-decode at 8k / 16k / 32k, low entropy, N 1-32 on the same 32 balanced prompts, at least three bursts per cell);
# smoke is a few-minute check of an engine
SUITE=${SUITE:-cross-engine}

# the suite's sampling (the checkpoint's own: temperature 1.0, top-p 0.95, top-k 20, min-p 0, thinking on at
# reasoning effort xhigh); run.sh sends one such request after each start and logs whether the engine thought
TEMPERATURE=1.0
TOP_P=0.95
REASONING=xhigh

# memory: an engine's total target on one GB10 (~121 GiB), and the guard that stops it before the machine hangs
ENGINE_BUDGET_GIB=102
GUARD_LOW_GIB=2          # stop the engine when MemAvailable stays under this ...
GUARD_SUSTAIN_S=20       # ... for this many seconds in a row

# machines run.sh will not benchmark on: spark-911c runs the desktop and the Claude Code sessions that drive the
# others, so its free memory and page cache are not an engine's own. RUN_ON_ANY_HOST=1 overrides.
AVOID_HOSTS=${AVOID_HOSTS:-"spark-911c"}

# where results go, and where sharar-eval keeps prompt sets and the client tokenizer
OUT_ROOT=${OUT_ROOT:-$HOME/engine-baselines}
# (one directory under both names: the pinned Hibana commit reads SHARAR_RESULTS, sharar-eval HIBANA_RESULTS first)
SHARAR_RESULTS=${SHARAR_RESULTS:-${HIBANA_RESULTS:-$HOME/.local/share/sharar}}
HIBANA_RESULTS=$SHARAR_RESULTS
