# Qwen3.8-Flash-Next past the recipe's 16 streams: --parallel TF_PARALLEL (default 32) as an extra start.sh argument
# (it wins over PARALLEL, which start.sh checks for 1-16), windows of TF_CONTEXT (default 12,288: 8k requests), and the
# reserve TF_RESERVE_GIB (default 9, the recipe's). The engine decodes up to 32 streams a round and more in turns.
# For trying a size by hand (TF_PARALLEL / TF_CONTEXT / TF_RESERVE_GIB / TF_ENV); the chosen warm-decode sizes are -maxfit.
# The agent-replay baseline: TF_PARALLEL=16 TF_CONTEXT=65536 TF_RESERVE_GIB=9 TF_ENV=TF_FLASHNEXT_HEAD_KV=fp8.
MODEL_REPO=nvidia/Qwen3.8-Flash-Next-FP4-Local
MODEL_REVISION=b9ce18a6887e18c089fdea8509a33e63429a3300
PARALLEL=16
TF_PARALLEL=${TF_PARALLEL:-32}
TF_ARGS="--parallel $TF_PARALLEL"
TF_CONTEXT=${TF_CONTEXT:-12288}
TF_RESERVE_GIB=${TF_RESERVE_GIB:-9}
VISION=0
SETTING_DESC="recipe defaults with --parallel $TF_PARALLEL, CONTEXT $TF_CONTEXT, VISION 0, reserve $TF_RESERVE_GIB GiB${TF_ENV:+, $TF_ENV} (recipe: 5, 262144, 1, 9)"
ENGINE_LABEL="TensorFold $TF_VERSION (${TF_REF:0:8} + recipe patches 0001-0017), MiaAI-Lab recipe ${RECIPE_COMMIT:0:7}, image $TF_IMAGE, ${MODEL_REPO}@${MODEL_REVISION:0:7}"
