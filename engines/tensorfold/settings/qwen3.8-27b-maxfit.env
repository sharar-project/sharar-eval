# Qwen3.8-27B with as many warm requests as fit one GB10 (the user's max-fit regime, no 102 GiB budget). No current
# recipe serves it (MiaAI-Lab's 27B recipe pins the Python engine 0.6), so this runs TensorFold's v1.1.7 release binary
# on the host (TF_LAUNCH=native) on NVIDIA's NVFP4 checkpoint, the one vLLM's rows serve; the native CUDA engine reads it
# since 1.1.5. DFlash2 drafts (z-lab, the drafter vLLM uses), thinking on, fp8 KV, text only.
# Per prompt size: TF_PARALLEL streams, TF_CONTEXT window, TF_RESERVE_GIB, TF_PCACHE prompt cache (GiB); each can be
# set from the environment to try a size by hand. Sizes from the 32k probe (2026-10-28, e108): a stream is ~0.92 GiB
# fixed + 32 KiB a window token (2.11 GiB at 38,912, fp8 caches; 78.3 GiB pool at reserve 7), a kept prompt one state of
# ~1.15 GiB at 35k tokens (fp8 KV; resumes at a 4,096-row chunk start, ~92% cached). 32 streams + 32 kept 32k prompts
# would need ~106 GiB, so 32k runs 16; the engine's own prompt cache (8 GiB, ~7 kept 32k prompts) is set per size.
# A kept prompt holds 2 states (at the last 32,768-row chunk start and at its end), each a full copy of its KV: ~0.6 /
# 1.2 / 2.2 GiB a prompt at 8k / 16k / 32k (runs of 2026-10-28). Cache 26 / 22 / 38 GiB: 32 at 8k, 16 at 16k and 32k
# (32 at 16k would need 38 GiB of cache beside 32 streams: past the pool).
TF_LAUNCH=native
TF_VERSION=1.1.7
TF_REF=59044397a0e3870b01062fb67cde898a43b9a911
TF_BIN=${TF_BIN:-$HOME/opt/tensorfold-1.1.7-linux-aarch64/bin/tensorfold-native}
SERVED_NAME=Qwen3.8-27B
MODEL_REPO=nvidia/Qwen3.8-27B-NVFP4
MODEL_REVISION=482ca0f3832238542f8f5295dde86b5f22711d80
DRAFTER_REPO=z-lab/Qwen3.8-27B-DFlash2
DRAFTER_REVISION=50307d4c4cde6860d4eee73e2547cd786fe8e8a4
case ${CONTEXT:-} in
  8k)  : "${TF_PARALLEL:=32}" "${TF_CONTEXT:=12288}" "${TF_RESERVE_GIB:=7}" "${TF_PCACHE:=26}" ;;
  16k) : "${TF_PARALLEL:=32}" "${TF_CONTEXT:=20480}" "${TF_RESERVE_GIB:=7}" "${TF_PCACHE:=22}" ;;
  agents) : "${TF_PARALLEL:=16}" "${TF_CONTEXT:=65536}" "${TF_RESERVE_GIB:=7}" "${TF_PCACHE:=26}" ;;   # agent replay: turns up to 57,587
  32k) : "${TF_PARALLEL:=16}" "${TF_CONTEXT:=38912}" "${TF_RESERVE_GIB:=7}" "${TF_PCACHE:=38}" ;;
  *) echo "setting qwen3.8-27b-maxfit takes one prompt size at a time: CONTEXT=8k, 16k, 32k or agents, not '${CONTEXT:-}'" >&2; exit 2 ;;
esac
PARALLEL=$TF_PARALLEL
TF_ARGS="--drafter ${HF_HUB_CACHE:-${HF_HOME:-$HOME/.cache/huggingface}/hub}/models--${DRAFTER_REPO//\//--}/snapshots/$DRAFTER_REVISION --kv-cache ${TF_KV:-fp8}${TF_PCACHE:+ --prompt-cache-gib $TF_PCACHE} ${TF_EXTRA:-}"
SETTING_DESC="MAX-FIT ($CONTEXT): --parallel $PARALLEL, --context $TF_CONTEXT, reserve $TF_RESERVE_GIB GiB, KV ${TF_KV:-fp8}, prompt cache ${TF_PCACHE:-engine default} GiB, DFlash2 drafts, text only"
ENGINE_LABEL="TensorFold $TF_VERSION release binary (${TF_REF:0:8}), ${MODEL_REPO}@${MODEL_REVISION:0:7} + ${DRAFTER_REPO}@${DRAFTER_REVISION:0:7}"
