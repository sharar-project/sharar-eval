# Qwen3.8-Flash-Next with as many warm requests as fit one GB10, outside the 102 GiB budget every other engine gets.
# One prompt size per run (run.sh's CONTEXT); each size has its own streams, window and reserve (README, section 4):
#   8k   32 streams, window 12,288, reserve 9 (the recipe's own)
#   16k  32 streams, window 19,968, reserve 5 (computed, first run 2026-10-28), MTP head cache fp8 and prompt chunks of 1,024 rows: without the fp8
#        head the window must clear patch 0005's line (22,528) and 32 slots plus 32 kept prompts no longer fit
#   32k  16 streams, window 40,960, reserve 7: 32 slots alone would take ~33 GiB
# --parallel past the recipe's start.sh check (PARALLEL 1-16); the engine decodes up to 32 streams a round.
MODEL_REPO=nvidia/Qwen3.8-Flash-Next-FP4-Local
MODEL_REVISION=b9ce18a6887e18c089fdea8509a33e63429a3300   # the recipe's pin (scripts/config.sh)
PARALLEL=16
VISION=0
case ${CONTEXT:-} in
  8k)  TF_PARALLEL=32; TF_CONTEXT=12288; TF_RESERVE_GIB=9 ;;
  16k) TF_PARALLEL=32; TF_CONTEXT=19968; TF_RESERVE_GIB=5; TF_ENV="TF_FLASHNEXT_HEAD_KV=fp8 TF_FLASHNEXT_CHUNK=1024" ;;
  32k) TF_PARALLEL=16; TF_CONTEXT=40960; TF_RESERVE_GIB=7 ;;
  *) echo "setting qwen3.8-flash-next-maxfit takes one prompt size at a time: CONTEXT=8k, 16k or 32k, not '${CONTEXT:-}'" >&2
     exit 2 ;;
esac
TF_ARGS="--parallel $TF_PARALLEL"
SETTING_DESC="MAX-FIT, outside the 102 GiB budget ($CONTEXT): --parallel $TF_PARALLEL, CONTEXT $TF_CONTEXT, reserve $TF_RESERVE_GIB GiB, VISION 0${TF_ENV:+, $TF_ENV} (recipe: 5, 262144, 9, 1)"
ENGINE_LABEL="TensorFold $TF_VERSION (${TF_REF:0:8} + recipe patches 0001-0017), MiaAI-Lab recipe ${RECIPE_COMMIT:0:7}, image $TF_IMAGE, ${MODEL_REPO}@${MODEL_REVISION:0:7}"
