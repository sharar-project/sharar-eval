# Nemotron 3.5 Bolt with as many warm requests as fit one GB10 (max-fit: outside the 102 GiB budget), through
# MiaAI-Lab's one-Spark recipe Nemotron-3.5-Bolt-TensorFold-DGX-Spark at 2cea422 (2026-10-27): TensorFold v1.1.6
# (eea9dc9c) with the recipe's libbolt backend for nemotron_h_puzzle, image tensorfold-nemotron-bolt:zig-eea9dc9 built
# by its scripts/prepare.sh. Checkpoint: the recipe's pin a326822, the same weights as the cf2effc Sharar's and vLLM's
# rows serve (only README.md and explainability.md differ); LiLiCorr drafter 4c6a561 (the recipe's pin; its config.json
# differs from vLLM's 449d241). Recipe defaults kept: bf16 KV mapped as streams grow, one Mamba state copy a stream
# (SSM_LAZY), LiLiCorr drafts with Q8_0 projections, NVFP4 prompt projections, thinking on, sampling. Changed: VISION 0,
# the window, the prompt cache, and the start.sh memory check (MEM_CHECK=0; the engine sizes itself).
RECIPE_REPO=https://github.com/MiaAI-Lab/Nemotron-3.5-Bolt-TensorFold-DGX-Spark.git
RECIPE_COMMIT=2cea422d64f2071ebbc7123965ad2f2ab72e8fd8
TF_DIR=${TF_DIR_BOLT:-$HOME/Nemotron-3.5-Bolt-TensorFold-DGX-Spark}
CONTAINER=nemotron35-bolt-tf
TF_VERSION=1.1.6
TF_REF=eea9dc9c9c8b459c0a03de7f6fe0c6f4835d69ab
TF_IMAGE=tensorfold-nemotron-bolt:zig-eea9dc9
MODEL_REPO=nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB
MODEL_REVISION=a326822af111290f2af5ac59ef4b5040347dabc4
case ${CONTEXT:-} in
  8k)  : "${TF_PARALLEL:=16}" "${TF_CONTEXT:=40960}" "${TF_RESERVE_GIB:=9}" "${TF_PCACHE:=24}" ;;
  16k) : "${TF_PARALLEL:=16}" "${TF_CONTEXT:=40960}" "${TF_RESERVE_GIB:=9}" "${TF_PCACHE:=24}" ;;
  agents) : "${TF_PARALLEL:=16}" "${TF_CONTEXT:=65536}" "${TF_RESERVE_GIB:=9}" "${TF_PCACHE:=24}" ;;   # agent replay: turns up to 57,587
  32k) : "${TF_PARALLEL:=16}" "${TF_CONTEXT:=40960}" "${TF_RESERVE_GIB:=9}" "${TF_PCACHE:=24}" ;;   # 2 states a 32k prompt, ~0.74 GiB
  *) echo "setting nemotron-3.5-bolt-maxfit takes one prompt size at a time: CONTEXT=8k, 16k, 32k or agents, not '${CONTEXT:-}'" >&2; exit 2 ;;
esac
PARALLEL=16                                  # start.sh's check (1-16); the engine takes TF_ARGS' --parallel
VISION=0
# 16 streams: libbolt keeps at most SEG_MAX = 16 sequences (engine/bolt_common.h, compiled in; BOLT_SEQS is clamped to it),
# and --parallel 32 is refused at start ("--parallel 32 needs 4.37 GiB ...: serve --parallel 16", 2026-10-28), so N 32
# queues: the row ends there. Memory is not the limit (~50 GiB stays free at 16 streams).
# libbolt maps a stream's KV only out of free memory, not out of the page cache: drop it before the start (a download
# beside a run failed a 33k prefill with "no memory to grow sequence 0 past 16384 tokens (3.0 GiB free)", 2026-10-28).
DROP_PAGE_CACHE=1
TF_ENV="PROMPT_CACHE_GIB=$TF_PCACHE KV_DTYPE=${TF_KV:-bf16} MEM_CHECK=0 ${TF_ENV_EXTRA:-}"
TF_ARGS="--parallel $TF_PARALLEL"
SETTING_DESC="MAX-FIT ($CONTEXT): --parallel $TF_PARALLEL, CONTEXT $TF_CONTEXT, reserve $TF_RESERVE_GIB GiB, prompt cache $TF_PCACHE GiB, KV ${TF_KV:-bf16}, VISION 0 (recipe: 16, 262144, 10, 8, bf16, 1)"
ENGINE_LABEL="TensorFold $TF_VERSION (${TF_REF:0:8}) + MiaAI-Lab Bolt recipe ${RECIPE_COMMIT:0:7} (libbolt), image $TF_IMAGE, ${MODEL_REPO}@${MODEL_REVISION:0:7} + LiLiCorr@4c6a561"
