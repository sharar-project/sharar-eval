# Nemotron 3.5 Super with as many warm requests as fit one GB10 (max-fit: outside the 102 GiB budget). No
# MiaAI recipe; the community one-GB10 recipe TensorFold links (plotarmordev, 72ef12b) runs the stock 1.1.3 binary on
# the host, so this does the same with the v1.1.7 release (TF_LAUNCH=native; Nemotron stream, KV and Mamba-slot fixes
# since 1.1.4). NVIDIA's NVFP4 checkpoint at 6aae0d6, the revision Hibana's and vLLM's rows serve: the same weights as
# TensorFold's pin 82d9369 (only README.md differs). MTP drafts (the engine's own rule), thinking on, text only.
TF_LAUNCH=native
TF_VERSION=1.1.7
TF_REF=59044397a0e3870b01062fb67cde898a43b9a911
TF_BIN=${TF_BIN:-$HOME/opt/tensorfold-1.1.7-linux-aarch64/bin/tensorfold-native}
SERVED_NAME=nemotron-3.5-super
MODEL_REPO=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
MODEL_REVISION=6aae0d6d0285e561bbb72efa10ba1425d41ebddc
case ${CONTEXT:-} in
  8k)  : "${TF_PARALLEL:=32}" "${TF_CONTEXT:=12288}" "${TF_RESERVE_GIB:=6}" "${TF_PCACHE:=24}" ;;
  16k) : "${TF_PARALLEL:=32}" "${TF_CONTEXT:=22528}" "${TF_RESERVE_GIB:=5}" "${TF_PCACHE:=24}" ;;   # largest 16k prompt 20,044 Nemotron tokens + 1,024
  agents) : "${TF_PARALLEL:=16}" "${TF_CONTEXT:=65536}" "${TF_RESERVE_GIB:=6}" "${TF_PCACHE:=20}" ;;   # agent replay: turns up to 57,587
  32k) : "${TF_PARALLEL:=16}" "${TF_CONTEXT:=38912}" "${TF_RESERVE_GIB:=7}" "${TF_PCACHE:=24}" ;;   # 32 streams leave a 49-slot / 8.2 GiB
       # prompt cache: a 32k prompt keeps 2 states (~0.55 GiB of rows), ~15 prompts, the rest evicted (probe 2026-10-28)
  *) echo "setting nemotron-3.5-super-maxfit takes one prompt size at a time: CONTEXT=8k, 16k, 32k or agents, not '${CONTEXT:-}'" >&2; exit 2 ;;
esac
# TF_PCACHE 24: the engine's default prompt cache is 16 GiB at most (49 snapshot slots + 8.2 GiB of rows), and a kept
# prompt takes 2 slots, so 32 warm requests need 64 slots: 24 GiB gives 64 slots + 13.8 GiB of rows (spark5, 2026-10-28).
# The 8k run on spark-2f9d (default cache) evicted at N 32; reserve 6 / 5 leave the room at 32 streams.
PARALLEL=$TF_PARALLEL
TF_ARGS="${TF_KV:+--kv-cache $TF_KV}${TF_PCACHE:+ --prompt-cache-gib $TF_PCACHE} ${TF_EXTRA:-}"
SETTING_DESC="MAX-FIT ($CONTEXT): --parallel $PARALLEL, --context $TF_CONTEXT, reserve $TF_RESERVE_GIB GiB, KV ${TF_KV:-engine default}, prompt cache ${TF_PCACHE:-engine default} GiB, MTP drafts, text only"
ENGINE_LABEL="TensorFold $TF_VERSION release binary (${TF_REF:0:8}), ${MODEL_REPO}@${MODEL_REVISION:0:7}"
