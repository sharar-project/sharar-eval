# TensorFold baselines: MiaAI-Lab's one-Spark recipe for Qwen3.8-Flash-Next, everything pinned. Sourced by serve.sh and
# common/run.sh after common/defaults.env. The recipe's scripts/config.sh pins the engine source, Zig, the base image
# and the checkpoint revision; serve.sh refuses a checkout at another commit.
EVAL_ENGINE=tensorfold            # no flush endpoint: kept prompts stay cached across bursts (oldest evicted first)
URL=http://127.0.0.1:8888
CONTAINER=qwen38-flash-next-tf    # the recipe's CONTAINER_NAME

# the recipe at this commit (2026-10-27, branch tensorfold-1.1.4 = main): TensorFold v1.1.4 (ashhart/TensorFold
# eab85828) with the recipe's patches 0001-0017, built by scripts/prepare.sh into tensorfold-qwen38:v1.1.4-eab8582
# on nvcr.io/nvidia/pytorch:26.07-py3 (no prebuilt image for this patch set on ghcr.io on 2026-10-27)
RECIPE_REPO=https://github.com/MiaAI-Lab/Qwen3.8-Flash-Next-Single-DGX-Spark-TensorFold.git
RECIPE_COMMIT=fd3f43e11238553685ebb68b6d8ab2b112818e3c
TF_VERSION=1.1.4
TF_REF=eab8582819688325e371907e4706e1c602b8a273
TF_IMAGE=tensorfold-qwen38:v1.1.4-eab8582
TF_DIR=${TF_DIR:-$HOME/Qwen3.8-Flash-Next-Single-DGX-Spark-TensorFold}   # the checkout at RECIPE_COMMIT (serve.sh clones it once)

START_TIMEOUT_S=${START_TIMEOUT_S:-5400}   # a first start builds the image (~30-60 min) unless prepare.sh ran before
