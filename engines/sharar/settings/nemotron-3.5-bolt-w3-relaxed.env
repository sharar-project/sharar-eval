# nemotron-3.5-bolt-w3 plus relaxed acceptance at Flash-Next's default thresholds (arm B). Sharar's docs list relaxed
# acceptance as off for Bolt in --fast/--throughput, so this arm is outside the validated defaults (quality not checked).
. $(dirname "${BASH_SOURCE[0]}")/nemotron-3.5-bolt-w3.env
export SHARAR_ACCEPT_DEFAULT=3:2.0 SHARAR_ACCEPT_DEFAULT_SAMPLED=1 SHARAR_ACCEPT_DEFAULT_SAMPLED_THRESHOLD=3:2.0
SETTING_DESC="$SETTING_DESC; relaxed acceptance top-3 within 2.0 logits, sampled requests too"
