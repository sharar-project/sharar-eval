# nemotron-3.5-bolt with Sharar's calibrated 3-bit trunk and head copies on (arm A of the 2026-10-29 Bolt check; exact
# acceptance as before). Sharar publishes no Bolt calibration: this is spark5's local GPTQ one (~/bolt-w3/ckpt-gptq,
# target revision cf2effc), copied to spark4 at the same path. The 10-28 Bolt agent runs on spark4 had w3_decode false.
. $(dirname "${BASH_SOURCE[0]}")/nemotron-3.5-bolt.env
export SHARAR_W3_CHECKPOINT=$HOME/bolt-w3/ckpt-gptq
SETTING_DESC="$SETTING_DESC; calibrated 3-bit trunk and head copies (local GPTQ calibration, bolt-w3/ckpt-gptq)"
