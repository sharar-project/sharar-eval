# nemotron-3.5-bolt with Hibana's calibrated 3-bit trunk and head copies, as the other three models are served (Hibana
# publishes no Bolt calibration). SHARAR_W3_CHECKPOINT names the calibration directory (GPTQ, target revision cf2effc);
# the same files are on Hugging Face as shadowpa0327/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-sharar-w3 (f2b8327).
. $(dirname "${BASH_SOURCE[0]}")/nemotron-3.5-bolt.env
export SHARAR_W3_CHECKPOINT=${SHARAR_W3_CHECKPOINT:-$HOME/bolt-w3/ckpt-gptq}
SETTING_DESC="$SETTING_DESC; calibrated 3-bit trunk and head copies (GPTQ, $SHARAR_W3_CHECKPOINT)"
