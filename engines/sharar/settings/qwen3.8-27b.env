# Qwen3.8-27B (RadixArk/Qwen3.8-27B-NVFP4): --throughput, up to 32 requests (the profile's default is 16), DFlash2
# drafts per batch size from the 2026-10-26 depth sweep (thinking on, balanced low entropy): 15 at 1, 10 at 2, 6 from 4
TARGET=27b
PROFILE=throughput
URL=http://127.0.0.1:30001
export SHARAR_MAX_BATCH=32 SHARAR_SPEC_DEPTHS=1:15,2:10,4:6,8:6,16:6,32:6
SETTING_DESC="27B --throughput, max batch 32, DFlash2 drafts 15/10/6 by batch size, relaxed acceptance, int8 recurrent state, SSD tier on"
ENGINE_LABEL="$SHARAR_LABEL, Qwen3.8-27B"
