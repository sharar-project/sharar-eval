# Qwen3.8-Flash-Next for suite cross-engine-n64: qwen3.8-flash-next.env with the batch limit at 64 instead of the shipped
# 128. Sharar sizes its recurrent-state slots (2 a request) and CUDA graphs by the limit, so 64 leaves about 7 GiB more to
# the KV pool: at 128 the pool held 1.48M tokens and 32k decoded at most 56 of 64 at once (2026-10-27)
TARGET=flashnext
PROFILE=throughput
URL=http://127.0.0.1:30004
export SHARAR_MAX_BATCH=64
SETTING_DESC="Flash-Next --throughput, max batch 64, otherwise as shipped: MTP drafts, relaxed acceptance, 3-bit copies, budgeted experts, int8 recurrent state, SSD tier on"
ENGINE_LABEL="$SHARAR_LABEL, Qwen3.8-Flash-Next"
