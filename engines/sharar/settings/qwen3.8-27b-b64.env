# Qwen3.8-27B for suite cross-engine-n64: qwen3.8-27b.env with the batch limit at 64 (6 drafts at 64, as from 4)
TARGET=27b
PROFILE=throughput
URL=http://127.0.0.1:30001
export SHARAR_MAX_BATCH=64 SHARAR_SPEC_DEPTHS=1:15,2:10,4:6,8:6,16:6,32:6,64:6
SETTING_DESC="27B --throughput, max batch 64, DFlash2 drafts 15/10/6 by batch size, relaxed acceptance, int8 recurrent state, SSD tier on"
ENGINE_LABEL="$SHARAR_LABEL, Qwen3.8-27B"
