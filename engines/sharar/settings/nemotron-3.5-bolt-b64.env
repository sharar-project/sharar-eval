# Nemotron 3.5 Bolt 74B-A9B 24GB for suite cross-engine-n64: nemotron-3.5-bolt.env with the batch limit at 64
TARGET=bolt
PROFILE=throughput
URL=http://127.0.0.1:30006
export SHARAR_MAX_BATCH=64
SETTING_DESC="Bolt --throughput, max batch 64, otherwise the profile's defaults (LiLiCorr DFlash2 drafts)"
ENGINE_LABEL="$SHARAR_LABEL, Nemotron 3.5 Bolt"
