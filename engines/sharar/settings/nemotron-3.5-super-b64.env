# Nemotron 3.5 Super VL 120B-A12B NVFP4 for suite cross-engine-n64: nemotron-3.5-super.env with the batch limit at 64
TARGET=nemotron
PROFILE=throughput
URL=http://127.0.0.1:30005
export SHARAR_MAX_BATCH=64
SETTING_DESC="Super --throughput, max batch 64, otherwise the profile's defaults (MTP drafts by batch size, relaxed acceptance, 3-bit copies, FP16 recurrent state with stochastic rounding)"
ENGINE_LABEL="$SHARAR_LABEL, Nemotron 3.5 Super"
