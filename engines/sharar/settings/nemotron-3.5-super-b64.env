# Nemotron 3.5 Super VL 120B-A12B NVFP4 for suite cross-engine-n64: nemotron-3.5-super.env with the batch limit at 64
TARGET=nemotron
PROFILE=throughput
URL=http://127.0.0.1:30005
export SHARAR_MAX_BATCH=64
SETTING_DESC="Super --throughput, max batch 64, otherwise the profile's defaults (MTP drafts by batch size, relaxed acceptance, 3-bit copies, FP16 recurrent state with stochastic rounding)"
ENGINE_LABEL="$SHARAR_LABEL, Nemotron 3.5 Super"
# At --max-batch 64 the pinned 7387a45 sizes FlashInfer's speculative-graph scratch by requests (256 MiB per 64) and Super
# needs 270 MB, so it does not start; this setting runs 7387a45 plus the fix that sizes it by verified rows (026767d,
# branch fix/spec-graphs-workspace-rows), which changes no computation
SHARAR_COMMIT=026767db640a50da9d7a817cce50f93ea614a891
SHARAR_DIR=$HOME/sharar-7387a45-ws
SHARAR_LABEL="Sharar main 7387a45 + spec-graph workspace fix (026767d)"
