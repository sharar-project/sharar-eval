# Nemotron 3.5 Bolt 74B-A9B 24GB: --throughput with up to 32 requests (at 7387a45 Bolt's --throughput sets what --fast
# does: max batch 4). 3-bit copies only if $SHARAR_RESULTS/w3-checkpoints/bolt-current exists (Hibana publishes none for
# Bolt); nemotron-3.5-bolt-w3 names them explicitly
TARGET=bolt
PROFILE=throughput
URL=http://127.0.0.1:30006
export SHARAR_MAX_BATCH=32
SETTING_DESC="Bolt --throughput, max batch 32, otherwise the profile's defaults (LiLiCorr DFlash2 drafts)"
ENGINE_LABEL="$SHARAR_LABEL, Nemotron 3.5 Bolt"
