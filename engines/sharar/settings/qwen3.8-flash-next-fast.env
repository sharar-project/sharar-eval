# Qwen3.8-Flash-Next (RadixArk/Qwen3.8-Flash-Next-NVFP4 with Hibana's 3-bit copies): --fast as shipped, up to 4
# requests; run with suite cross-engine-n4
TARGET=flashnext
PROFILE=fast
URL=http://127.0.0.1:30004
SETTING_DESC="Flash-Next --fast as shipped: up to 4 requests, MTP drafts adaptive by batch size, relaxed acceptance, 3-bit copies, SSD tier on"
ENGINE_LABEL="$SHARAR_LABEL, Qwen3.8-Flash-Next"
