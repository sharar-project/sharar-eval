# Hibana (then Sharar; sharar-project/hibana) main at 7387a45 (2026-10-27), a plain checkout. Sourced by serve.sh and
# common/run.sh after common/defaults.env; settings/<model>.env names the target, profile, port and any overrides.
# The checkpoints are its own pins at this commit (sharar/model/*/config.py), fetched on the first start.
SHARAR_LABEL="Sharar main 7387a45"
EVAL_ENGINE=sharar                 # sharar-eval flushes with /flush_cache and reads /get_server_info
SHARAR_REPO=https://github.com/sharar-project/hibana.git
SHARAR_COMMIT=${SHARAR_COMMIT:-7387a450e14e032ce1d5cbee2edca41326bea6d3}
SHARAR_DIR=${SHARAR_DIR:-$HOME/sharar-main-7387a45}   # the checkout at SHARAR_COMMIT

# a fresh SSD-tier store for every start (SHARAR_SSD_DIR)
SHARAR_SSD_ROOT=${SHARAR_SSD_ROOT:-$SHARAR_RESULTS/ssd-baseline}
