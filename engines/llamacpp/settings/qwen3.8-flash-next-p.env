# Qwen3.8-Flash-Next on llama.cpp: ISTA-DASLab's GSQ-RCO IQ3_S GGUF (two shards, 83.6 GB) with ggml-org's Q8_0 MTP
# head (3 drafts), q8_0 KV in one pool shared by every slot (-kvu). The published 16k warm-decode and agent-replay rows.
# Sizes come from the drivers (warm.sh: N slots of SLOT_TOKENS each; agents.sh: AGENT_POOLS); LLAMA_SLOTS / LLAMA_CTX /
# LLAMA_ARGS from the environment start one server by hand.
GGUF_REPO=ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF
GGUF_REVISION=ed59f92082b1e93c0e96d60a8b11aab089b52f09
GGUF=${GGUF:-$HF_HUB_CACHE/models--ISTA-DASLab--Qwen3.8-Flash-Next-GSQ-RCO-GGUF/snapshots/$GGUF_REVISION/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf}
DRAFT_GGUF=${DRAFT_GGUF:-$LLAMACPP_HOME/mtp-Qwen3.8-Flash-Next-Q8_0.gguf}
DRAFT_REPO=ggml-org/Qwen3.8-Flash-Next-GGUF
DRAFT_REVISION=92796c044d1e70d66a373598709092f2989f4155   # 2026-10-19; main moved on 10-21
DRAFT_SHA256=6be8a94e2d94107b7f38fdc957c3460ffeb6ff6302edef92c50738682f9dc0e0
SPEC_TYPE=${SPEC_TYPE:-draft-mtp}
DRAFTS=3
KV_TYPE=q8_0
SERVED_MODEL=iq3_s
# warm decode (warm.sh): N slots of 20,480 tokens (a 16k prompt and its 1,024-token answer fit in ~19.5k); 88 GB of
# weights leave ~7 GiB beside 8 slots, so N 16 and 32 do not load
SLOT_TOKENS=20480
WARM_ARGS="-cram 0"
WARM_N_MAX=8
# agent replay (agents.sh): agents:pool tokens; every agent's history stays in its slot, so the pool holds them all.
# 32 agents run on 16 slots (the other 16 wait): 32 slots do not fit. -ub 512 shrinks the compute buffers to make room.
AGENT_ARGS="-cram 0 --jinja -ub 512 -ctxcp 3"
AGENT_POOLS="1:81920 8:245760 16:393216 32:393216"
AGENT_SLOTS_MAX=16
SLOTS=${LLAMA_SLOTS:-4}
CTX_SIZE=${LLAMA_CTX:-$((SLOTS * SLOT_TOKENS))}
SETTING_DESC="-np $SLOTS, one shared $CTX_SIZE-token q8_0 KV (-kvu), flash attention, MTP up to $DRAFTS drafts${LLAMA_ARGS:+, $LLAMA_ARGS}"
ENGINE_LABEL="llama.cpp $LLAMA_COMMIT, $GGUF_REPO@${GGUF_REVISION:0:7} IQ3_S + $DRAFT_REPO@${DRAFT_REVISION:0:7} Q8_0 MTP head"
