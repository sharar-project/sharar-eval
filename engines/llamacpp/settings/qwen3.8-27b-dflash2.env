# Qwen3.8-27B on llama.cpp: ggml-org's Q4_K_M GGUF with a DFlash2 drafter converted here from z-lab/Qwen3.8-27B-DFlash2
# (the safetensors vLLM serves; the published DFlash2 GGUFs predate llama.cpp's DFlash2 support, PR #27342), 4 drafts,
# q8_0 KV shared by every slot (-kvu). The published 16k warm-decode and agent-replay rows. Conversion: README section 2.
GGUF_REPO=ggml-org/Qwen3.8-27B-GGUF
GGUF_REVISION=a316ea527fde32c12487be7574e2db5ac2ad2a7e
GGUF=${GGUF:-$HF_HUB_CACHE/models--ggml-org--Qwen3.8-27B-GGUF/snapshots/$GGUF_REVISION/Qwen3.8-27B-Q4_K_M.gguf}
DRAFT_REPO=z-lab/Qwen3.8-27B-DFlash2
DRAFT_REVISION=50307d4c4cde6860d4eee73e2547cd786fe8e8a4
TARGET_CONFIG_REPO=Qwen/Qwen3.8-27B                       # config and tokenizer the converter reads
TARGET_CONFIG_REVISION=1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0
DRAFT_GGUF=${DRAFT_GGUF:-$LLAMACPP_HOME/dflash2-Qwen3.8-27B-50307d4-Q8_0.gguf}
SPEC_TYPE=${SPEC_TYPE:-draft-dflash}
DRAFTS=4
KV_TYPE=q8_0
SERVED_MODEL=q4_k_m
SLOT_TOKENS=20480
WARM_ARGS="-cram 0"
WARM_N_MAX=32
AGENT_ARGS="-cram 0 --jinja -ctxcp 3"
AGENT_POOLS="1:81920 8:245760 16:425984 32:851968"
AGENT_SLOTS_MAX=32
SLOTS=${LLAMA_SLOTS:-4}
CTX_SIZE=${LLAMA_CTX:-$((SLOTS * SLOT_TOKENS))}
SETTING_DESC="-np $SLOTS, one shared $CTX_SIZE-token q8_0 KV (-kvu), flash attention, DFlash2 up to $DRAFTS drafts${LLAMA_ARGS:+, $LLAMA_ARGS}"
ENGINE_LABEL="llama.cpp $LLAMA_COMMIT, $GGUF_REPO@${GGUF_REVISION:0:7} Q4_K_M + DFlash2 ($DRAFT_REPO@${DRAFT_REVISION:0:7}, converted Q8_0)"
