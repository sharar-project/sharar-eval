# Nemotron 3.5 Super on llama.cpp: ggml-org's lowest-bit GGUF (Q4_0, 72 GB) with the repo's LiLiCorr NVFP4 drafter
# (draft-dflash, 3 drafts), q8_0 KV shared by every slot (-kvu), text only. The published 16k warm-decode and
# agent-replay rows. Loads as GGUF arch nemotron_h_moe (llama.cpp PRs #30520, #30506).
GGUF_REPO=ggml-org/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-GGUF
GGUF_REVISION=99144d1d7a318f045f1412a85bbb807f3c8a17a0
SNAP=$HF_HUB_CACHE/models--ggml-org--NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-GGUF/snapshots/$GGUF_REVISION
GGUF=${GGUF:-$SNAP/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-Q4_0.gguf}
DRAFT_REPO=$GGUF_REPO
DRAFT_REVISION=$GGUF_REVISION
DRAFT_GGUF=${DRAFT_GGUF:-$SNAP/lilicorr-NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4.gguf}
SPEC_TYPE=${SPEC_TYPE:-draft-dflash}
DRAFTS=3
KV_TYPE=q8_0
SERVED_MODEL=super-q4_0
SLOT_TOKENS=22528
WARM_ARGS="-cram 0 --jinja"
WARM_N_MAX=16          # N 32 started with 9 GiB free and its requests failed while the prompts were loading
# 32 agents run on 16 slots (the other 16 wait): 32 slots x 3 context checkpoints of 174 MiB each ran the box out of
# memory two minutes in (host OOM kill)
AGENT_ARGS="-cram 0 --jinja -ctxcp 3"
AGENT_POOLS="1:81920 8:262144 16:425984 32:425984"
AGENT_SLOTS_MAX=16
SLOTS=${LLAMA_SLOTS:-4}
CTX_SIZE=${LLAMA_CTX:-$((SLOTS * SLOT_TOKENS))}
SETTING_DESC="-np $SLOTS, one shared $CTX_SIZE-token q8_0 KV (-kvu), flash attention, LiLiCorr DFlash up to $DRAFTS drafts${LLAMA_ARGS:+, $LLAMA_ARGS}"
ENGINE_LABEL="llama.cpp $LLAMA_COMMIT, $GGUF_REPO@${GGUF_REVISION:0:7} Q4_0 + LiLiCorr NVFP4 drafter GGUF"
