# Nemotron 3.5 Bolt on llama.cpp: NVIDIA's own GGUF (IQ2, 22 GB) with its LiLiCorr DFlash drafter GGUF and NVIDIA's
# 128 GB recipe flags (7 drafts, -b 4096 -ub 2048), q8_0 KV shared by every slot (-kvu), text only. The published 16k
# warm-decode and agent-replay rows. Loads as GGUF arch nemotron_h_moe (llama.cpp PRs #30520, #30506).
GGUF_REPO=nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-GGUF
GGUF_REVISION=e0fecb69cb3e5e4c5e8a056fa2aec98c78e91246
GGUF=${GGUF:-$HF_HUB_CACHE/models--nvidia--NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-GGUF/snapshots/$GGUF_REVISION/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB.gguf}
DRAFT_REPO=nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr-GGUF
DRAFT_REVISION=182d2987939e12f458298b5d5f6ef98912f4ad6c
DRAFT_GGUF=${DRAFT_GGUF:-$HF_HUB_CACHE/models--nvidia--NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr-GGUF/snapshots/$DRAFT_REVISION/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr.gguf}
SPEC_TYPE=${SPEC_TYPE:-draft-dflash}
DRAFTS=7
KV_TYPE=q8_0
SERVED_MODEL=bolt-iq2
# Nemotron's tokenizer makes the 16k prompts up to 20,044 tokens, so slots are 22,528 (20,480 cut prompts short)
SLOT_TOKENS=22528
WARM_ARGS="-cram 0 -b 4096 -ub 2048 --jinja"
WARM_N_MAX=32
AGENT_ARGS="-cram 0 --jinja -b 4096 -ub 2048 -ctxcp 3"
AGENT_POOLS="1:81920 8:262144 16:425984 32:851968"
AGENT_SLOTS_MAX=32
SLOTS=${LLAMA_SLOTS:-4}
CTX_SIZE=${LLAMA_CTX:-$((SLOTS * SLOT_TOKENS))}
SETTING_DESC="-np $SLOTS, one shared $CTX_SIZE-token q8_0 KV (-kvu), flash attention, LiLiCorr DFlash up to $DRAFTS drafts${LLAMA_ARGS:+, $LLAMA_ARGS}"
ENGINE_LABEL="llama.cpp $LLAMA_COMMIT, $GGUF_REPO@${GGUF_REVISION:0:7} (IQ2) + LiLiCorr DFlash GGUF@${DRAFT_REVISION:0:7}"
