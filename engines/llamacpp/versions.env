# llama.cpp baselines: everything pinned. Sourced by serve.sh, warm.sh, agents.sh and common/run.sh after common/defaults.env
# (no secrets). Each setting names its GGUF, drafter and SERVED_MODEL.
EVAL_ENGINE=llama.cpp             # no flush endpoint: prompts primed for earlier bursts stay in their slots
PORT=${LLAMA_PORT:-8081}
URL=http://127.0.0.1:$PORT

# engine: built from source (README section 2), llama-server only
LLAMA_COMMIT=547208d
LLAMA_TARBALL=https://codeload.github.com/ggml-org/llama.cpp/tar.gz/547208d
LLAMA_CMAKE_FLAGS="-DGGML_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=121 -DCMAKE_BUILD_TYPE=Release -DGGML_CUDA_FA=ON -DGGML_CUDA_GRAPHS=ON -DLLAMA_CURL=OFF"

# where things live on this machine (override in the environment)
LLAMA_DIR=${LLAMA_DIR:-$HOME/llama.cpp}                  # llama-server at $LLAMA_DIR/build/bin/llama-server
LLAMACPP_HOME=${LLAMACPP_HOME:-$HOME/llamacpp-baseline}  # the Flash-Next MTP head and the converted 27B DFlash2 drafter
HF_HUB_CACHE=${HF_HUB_CACHE:-$HOME/.cache/huggingface/hub}

START_TIMEOUT_S=${START_TIMEOUT_S:-600}
