# vLLM baselines: eugr/spark-vllm-docker's single-Spark recipe for each model, everything pinned. Sourced by serve.sh
# and common/run.sh after common/defaults.env; settings/<model>.env names the recipe, image and model revisions.
EVAL_ENGINE=vllm                  # sharar-eval flushes vLLM's prefix cache with /reset_prefix_cache before every burst
URL=http://127.0.0.1:8000
CONTAINER=vllm-baseline

# the recipes: run by the repository's own run-recipe.sh at this commit (2026-10-26)
RECIPE_REPO=https://github.com/eugr/spark-vllm-docker
RECIPE_COMMIT=b62168ed4eb5dd8d788274e7a1677e7ce271bf5b
EUGR_DIR=${EUGR_DIR:-$HOME/spark-vllm-docker-b62168e}   # the checkout at RECIPE_COMMIT (serve.sh clones it once)

# the images the recipes name, pinned by digest: vllm-node (eugr/spark-vllm:latest = nightly-20261016 on 2026-10-27)
# and vllm-node-b12x (eugr/spark-vllm-b12x:latest = nightly-20261026 on 2026-10-27, after the Flash-Next recipe's
# 2026-10-25 regression fix)
IMAGE_REGULAR=eugr/spark-vllm@sha256:431593a0a7064bd41d9b2720ca5d00185540ce0fdf1e893adf85af9c07dc7175
IMAGE_B12X=eugr/spark-vllm-b12x@sha256:57c24fc397c66d4d28a7d0d5f1d792934fd01a70f4574cff6315fb7bc329d5cb

# the one change from every recipe: they run 8 sequences; the cross-engine suite decodes up to 32 at once
MAX_NUM_SEQS=32

HF_HUB_DIR=${HF_HUB_DIR:-$HOME/.cache/huggingface/hub}
START_TIMEOUT_S=${START_TIMEOUT_S:-10800}   # a first start compiles kernels: up to 3 h
