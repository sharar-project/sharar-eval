# qwen3.8-flash-next-d2 with block-aligned recurrent checkpoints every 2,992 tokens (one Mamba block) instead of the
# request-boundary policy: the SWE-bench fix candidate that does not rely on request boundaries at all
. $(dirname "${BASH_SOURCE[0]}")/qwen3.8-flash-next-d2.env
SETTING_DESC="$SETTING_DESC; recurrent checkpoints: aligned policy, every 2,992 tokens"
VLLM_ARGS="$VLLM_ARGS --recurrent-checkpoint-policy aligned --prefix-cache-retention-interval 2992"
