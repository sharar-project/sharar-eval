# Qwen3.8-27B: recipes/qwen3.8-27b-nvfp4-dflash2.yaml, solo (tensor parallel 1)
RECIPE=qwen3.8-27b-nvfp4-dflash2
IMAGE=$IMAGE_REGULAR
IMAGE_DIGEST=${IMAGE##*:}
MODEL_REPO=nvidia/Qwen3.8-27B-NVFP4
MODEL_REVISION=482ca0f3832238542f8f5295dde86b5f22711d80
DRAFT_REPO=z-lab/Qwen3.8-27B-DFlash2
DRAFT_REVISION=50307d4c4cde6860d4eee73e2547cd786fe8e8a4
SETTING_DESC="eugr recipe $RECIPE: DFlash2 8 drafts, FP8 KV, 4,096 batched tokens, memory 0.84 (recipe 0.8); max-num-seqs $MAX_NUM_SEQS"
ENGINE_LABEL="vLLM, eugr/spark-vllm-docker ${RECIPE_COMMIT:0:7}, image ${IMAGE%@*}@${IMAGE_DIGEST:0:12}, ${MODEL_REPO}@${MODEL_REVISION:0:7}"
# Memory 0.84 instead of the recipe's 0.8: the recipe's cache filled before N 32. 0.86 (as Super) left e108, whose
# 119.7 GiB is the smallest here, under 2 GiB available once requests ran, and the memory guard stopped it (2026-10-27);
# low-N speed is unchanged by the memory share (Super: 37/53/69 tok/s at N 1/2/4 at 0.8 and 0.86).
VLLM_ARGS="--gpu-memory-utilization 0.84"
DROP_PAGE_CACHE=1
