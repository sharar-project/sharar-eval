# nemotron-3.5-super-d3 at memory 0.84 instead of 0.86: on spark5 (2026-10-29) the 0.86 start ran the GPU out of memory
# in the fp8_gemm / fused-MoE autotune (NVRM NV_ERR_NO_MEMORY) before serving; used only if the 0.86 retry fails too
. $(dirname "${BASH_SOURCE[0]}")/nemotron-3.5-super-d3.env
SETTING_DESC="${SETTING_DESC/memory 0.86/memory 0.84}"
VLLM_ARGS="--gpu-memory-utilization 0.84 --speculative_config.num_speculative_tokens 3"
