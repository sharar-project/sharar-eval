# qwen3.8-flash-next-d2 with prefill chunks of 1024 tokens instead of the recipe's 4,096: vLLM keeps one recurrent
# checkpoint before a long prompt's final chunk, so a smaller chunk should leave it closer to the end of the prompt
. $(dirname "${BASH_SOURCE[0]}")/qwen3.8-flash-next-d2.env
SETTING_DESC="$SETTING_DESC; max-num-batched-tokens 1024"
VLLM_ARGS="$VLLM_ARGS --max-num-batched-tokens 1024"
