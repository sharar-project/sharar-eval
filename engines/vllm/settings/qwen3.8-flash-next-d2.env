# Qwen3.8-Flash-Next: recipes/qwen3.8-flash-next-nvfp4-solo.yaml (B12X image). NVIDIA's FP4-Local checkpoint, not the
# RadixArk NVFP4 one Hibana serves; per-layer embedding tables on disk; its MTP head drafts
RECIPE=qwen3.8-flash-next-nvfp4-solo
IMAGE=$IMAGE_B12X
IMAGE_DIGEST=${IMAGE##*:}
MODEL_REPO=nvidia/Qwen3.8-Flash-Next-FP4-Local
MODEL_REVISION=b9ce18a6887e18c089fdea8509a33e63429a3300
SETTING_DESC="eugr recipe $RECIPE: MTP 2 drafts (recipe 4), FP8 KV, PLE tables on disk, 4,096 batched tokens, memory 0.86 and PyTorch cap 0.86 (recipe 0.8 and 0.8); max-num-seqs $MAX_NUM_SEQS"
ENGINE_LABEL="vLLM, eugr/spark-vllm-docker ${RECIPE_COMMIT:0:7}, image ${IMAGE%@*}@${IMAGE_DIGEST:0:12}, ${MODEL_REPO}@${MODEL_REVISION:0:7}"
# Memory 0.86 instead of the recipe's 0.8 (as nemotron-3.5-super): the recipe's cache filled before N 32, and 0.86 is the
# most vLLM starts with on every Spark here; low-N speed is unchanged (Super: 37/53/69 tok/s at N 1/2/4 at both).
# The recipe also caps PyTorch's allocator at 0.8 (PYTORCH_ALLOC_CONF), which would hold the cache back: raised with it
VLLM_ARGS="--gpu-memory-utilization 0.86"
VLLM_ENV="PYTORCH_ALLOC_CONF=per_process_memory_fraction:0.86"
DROP_PAGE_CACHE=1
# 2 MTP drafts instead of 4: a recurrent state per draft token for every request, so fewer drafts fit more requests
# the recipe passes --speculative-config as one JSON value, which a dotted override replaces instead of merging into
# (vLLM then has no draft method and does not start), so the whole JSON is given again with 2 drafts; no spaces in it
VLLM_ARGS='--gpu-memory-utilization 0.86 --speculative-config {"method":"mtp","num_speculative_tokens":2}'
