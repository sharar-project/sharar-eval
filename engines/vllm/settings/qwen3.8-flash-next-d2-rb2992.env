# qwen3.8-flash-next-d2 plus periodic recurrent-state checkpoints every 2,992 tokens (one Mamba block) on top of the
# default request-boundary policy ("auto"): tests whether SWE-bench turns, which drop the previous request's final
# "Tool-call turn" message, can resume at the last block before it instead of the 477/4,096 checkpoints
. $(dirname "${BASH_SOURCE[0]}")/qwen3.8-flash-next-d2.env
SETTING_DESC="$SETTING_DESC; recurrent checkpoints: auto policy + every 2,992 tokens"
VLLM_ARGS="$VLLM_ARGS --prefix-cache-retention-interval 2992"
