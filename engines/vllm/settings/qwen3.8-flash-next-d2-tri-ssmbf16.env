# qwen3.8-flash-next-d2 on vLLM's Triton Gated DeltaNet kernels with the recurrent state stored in BF16 instead of the
# config's FP32: halves each saved state, so more conversations fit; lossy, accuracy not checked here
. $(dirname "${BASH_SOURCE[0]}")/qwen3.8-flash-next-d2.env
SETTING_DESC="$SETTING_DESC; Triton GDN prefill and decode; SSM state BF16"
VLLM_ARGS="$VLLM_ARGS --gdn-prefill-backend triton --gdn-decode-kernel triton --mamba-ssm-cache-dtype bfloat16"
