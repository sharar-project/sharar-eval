# Nemotron 3.5 Super VL 120B-A12B NVFP4, 3 drafts: recipes/nemotron-3.5-super-vl-nvfp4.yaml. The revision Hibana pins; the
# later da5b265 only deletes a backup chat template
RECIPE=nemotron-3.5-super-vl-nvfp4
IMAGE=$IMAGE_REGULAR
IMAGE_DIGEST=${IMAGE##*:}
MODEL_REPO=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
MODEL_REVISION=6aae0d6d0285e561bbb72efa10ba1425d41ebddc
DRAFT_REPO=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4-LiLiCorr
DRAFT_REVISION=292bf1efc06ba39567da7351f2ad7a522afa3959
SETTING_DESC="eugr recipe $RECIPE with 3 LiLiCorr DFlash drafts (recipe 7), FP8 KV, FP16 Mamba state with stochastic rounding, memory 0.86 (recipe 0.8); max-num-seqs $MAX_NUM_SEQS"
ENGINE_LABEL="vLLM, eugr/spark-vllm-docker ${RECIPE_COMMIT:0:7}, image ${IMAGE%@*}@${IMAGE_DIGEST:0:12}, ${MODEL_REPO}@${MODEL_REVISION:0:7}"
# The recipe with 3 DFlash drafts instead of 7, and memory 0.86 as nemotron-3.5-super. vLLM keeps a Mamba state per
# draft token for every request, so 3 drafts cut a warm 8k request's cache share from 12.7% to 3.2% (2026-10-27 test
# at 0.8: 16 at once at 51%, against 7 at 89%); the figures take vLLM's faster setting at each N. Its prefix cache then
# reuses 4,352 tokens of an 8k prompt (52%), so the floor is 50%, and bursts are primed three times.
VLLM_ARGS="--gpu-memory-utilization 0.86 --speculative_config.num_speculative_tokens 3"
DROP_PAGE_CACHE=1
PRIME_PASSES=3
MIN_HIT=0.5
