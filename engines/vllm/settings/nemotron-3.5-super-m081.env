# Nemotron 3.5 Super VL 120B-A12B NVFP4 at memory 0.81, for a Spark with less free memory: recipes/nemotron-3.5-super-vl-nvfp4.yaml. The revision Hibana pins; the
# later da5b265 only deletes a backup chat template
RECIPE=nemotron-3.5-super-vl-nvfp4
IMAGE=$IMAGE_REGULAR
IMAGE_DIGEST=${IMAGE##*:}
MODEL_REPO=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
MODEL_REVISION=6aae0d6d0285e561bbb72efa10ba1425d41ebddc
DRAFT_REPO=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4-LiLiCorr
DRAFT_REVISION=292bf1efc06ba39567da7351f2ad7a522afa3959
SETTING_DESC="eugr recipe $RECIPE: LiLiCorr DFlash 7 drafts, FP8 KV, FP16 Mamba state with stochastic rounding, memory 0.81 (recipe 0.8); max-num-seqs $MAX_NUM_SEQS"
ENGINE_LABEL="vLLM, eugr/spark-vllm-docker ${RECIPE_COMMIT:0:7}, image ${IMAGE%@*}@${IMAGE_DIGEST:0:12}, ${MODEL_REPO}@${MODEL_REVISION:0:7}"
# the recipe's mamba shared-prefix checkpoints keep a prompt only once vLLM has seen it twice (8,320 of 8,321 tokens
# cached on the third request, none on the first two), so each burst is primed twice; decoding is unchanged
PRIME_PASSES=2
# Memory 0.81 instead of nemotron-3.5-super's 0.86 (the recipe's 0.8 ran 7 warm 8k requests at once, 0.86 runs 11: each
# takes 2.1 GiB of KV cache, a full Mamba state per draft token, 7 drafts, in each Mamba group; 2026-10-27 test).
VLLM_ARGS="--gpu-memory-utilization 0.81"
DROP_PAGE_CACHE=1
# spark-911c (where other sessions run) has 100.4 GiB free at start, under the 104.7 GiB that 0.86 asks for, so vLLM
# refuses to start there; 0.82 (99.79 GiB) then missed by 0.02 GiB as its free memory shrank. 0.81 (98.6 GiB) runs about 8
# requests at once instead of 11.
