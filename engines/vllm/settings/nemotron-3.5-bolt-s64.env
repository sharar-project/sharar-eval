# Nemotron 3.5 Bolt for suite cross-engine-n64: nemotron-3.5-bolt.env with max-num-seqs 64. At N 32 vLLM held at most 39.5%
# of its 61.9 GiB KV cache (2026-10-27), so 64 requests fit
MAX_NUM_SEQS=64
RECIPE=nemotron-3.5-bolt-24gb
IMAGE=$IMAGE_REGULAR
IMAGE_DIGEST=${IMAGE##*:}
MODEL_REPO=nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB
MODEL_REVISION=cf2effc5c4b794ee9fb8d34eab3d1d65ce64142f
DRAFT_REPO=nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr
DRAFT_REVISION=449d24140160b8e51871bfc0f0a7338abf640aa1
SETTING_DESC="eugr recipe $RECIPE: LiLiCorr DFlash 7 drafts, FP8 KV, 8,192 batched tokens, memory 0.8; max-num-seqs $MAX_NUM_SEQS"
ENGINE_LABEL="vLLM, eugr/spark-vllm-docker ${RECIPE_COMMIT:0:7}, image ${IMAGE%@*}@${IMAGE_DIGEST:0:12}, ${MODEL_REPO}@${MODEL_REVISION:0:7}"
# the recipe's mamba shared-prefix checkpoints keep a prompt only once vLLM has seen it twice (8,320 of 8,321 tokens
# cached on the third request, none on the first two), so each burst is primed twice; decoding is unchanged
PRIME_PASSES=2
# it keeps Mamba state only every 4,544 tokens (the attention block it sets to match a Mamba page), so a prompt reuses
# up to its last multiple of 4,544: 54% of an 8k prompt, 80% of 16k, 94% of 32k; the row would stop at the suite's 60%
MIN_HIT=0.5
