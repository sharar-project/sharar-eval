# qwen3.8-flash-next-d2 on vLLM's Triton Gated DeltaNet kernels instead of the recipe's b12x ones (FP32 state): the
# control for the BF16-state run, which b12x's prefill kernel refuses (state_dtype must be torch.float32)
. $(dirname "${BASH_SOURCE[0]}")/qwen3.8-flash-next-d2.env
SETTING_DESC="$SETTING_DESC; Triton GDN prefill and decode"
VLLM_ARGS="$VLLM_ARGS --gdn-prefill-backend triton --gdn-decode-kernel triton"
