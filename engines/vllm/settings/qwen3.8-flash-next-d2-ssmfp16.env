# qwen3.8-flash-next-d2 with the Gated DeltaNet recurrent state stored in FP16 (round to nearest) instead of the
# config's FP32: halves each saved state, so more conversations and checkpoints fit; lossy, accuracy not checked here
. $(dirname "${BASH_SOURCE[0]}")/qwen3.8-flash-next-d2.env
SETTING_DESC="$SETTING_DESC; SSM state FP16 (round to nearest)"
VLLM_ARGS="$VLLM_ARGS --mamba-ssm-cache-dtype float16"
